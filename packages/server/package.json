{
  "name": "@invokable/server",
  "version": "0.3.1",
  "description": "Self-hostable device-code auth endpoints for invokable tools.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beinvokable/invokable.git",
    "directory": "packages/server"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@invokable/core": "workspace:^",
    "@electric-sql/pglite": "^0.5.8"
  }
}
