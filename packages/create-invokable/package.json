{
  "name": "create-invokable",
  "version": "0.4.0",
  "description": "Scaffold an agent-native CLI.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "create-invokable": "./bin/create-invokable.mjs"
  },
